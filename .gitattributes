# Keep LF line endings in the working tree on every OS.
# Makefiles, shell scripts and Python break with CRLF (Windows git with core.autocrlf=true).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.pdf binary
*.npy binary
*.npz binary
