{
  "model": "claude-opus-5-5",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make venv)",
      "Bash(make build-cpu)",
      "Bash(make test)",
      "Bash(make test-openfhe-local)",
      "Bash(make test-gpu)",
      "Bash(make test-openfhe)",
      "Bash(make fmt)",
      "Bash(make lint)",
      "Bash(make clean)",
      "Bash(cmake -S:*)",
      "Bash(cmake --build:*)",
      "Bash(ctest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python -m ruff:*)",
      "Bash(python3 -m ruff:*)",
      "Bash(clang-format:*)",
      "Bash(modal run modal_app.py:*)",
      "Bash(modal volume get ombra-data:*)",
      "Bash(modal volume ls ombra-data:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(modal deploy:*)",
      "Bash(modal secret:*)",
      "Bash(modal token:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./keys/**)",
      "Read(./secrets/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
